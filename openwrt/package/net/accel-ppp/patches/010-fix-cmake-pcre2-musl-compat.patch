index 3ebca78..60088bc 100644
--- a/accel-pppd/CMakeLists.txt
+++ b/accel-pppd/CMakeLists.txt
@@ -44,6 +44,49 @@ IF (RADIUS)
 	ADD_SUBDIRECTORY(radius)
 ENDIF (RADIUS)
 
+# MUSL compatibility checks
+INCLUDE (CheckCSourceCompiles)
+CHECK_C_SOURCE_COMPILES("
+#include <stdlib.h>
+#include <search.h>
+int main(void)
+{
+	__free_fn_t *f;
+	return 0;
+}" HAVE_FREE_FN_T)
+IF (HAVE_FREE_FN_T)
+	ADD_DEFINITIONS(-DHAVE_FREE_FN_T)
+ENDIF (HAVE_FREE_FN_T)
+
+CHECK_C_SOURCE_COMPILES("
+#include <sys/socket.h>
+#include <linux/if_arp.h>
+#include <net/ethernet.h>
+int main(void)
+{
+	return 0;
+}" HAVE_GOOD_IFARP)
+IF (HAVE_GOOD_IFARP)
+	ADD_DEFINITIONS(-DHAVE_GOOD_IFARP)
+ENDIF (HAVE_GOOD_IFARP)
+
+CHECK_C_SOURCE_COMPILES("
+#include <utmp.h>
+int main(void)
+{
+	logwtmp(\"\", \"\", \"\");
+	return 0;
+}" HAVE_LOGWTMP)
+IF (HAVE_LOGWTMP)
+	ADD_DEFINITIONS(-DHAVE_LOGWTMP)
+ENDIF (HAVE_LOGWTMP)
+
+INCLUDE(CheckIncludeFile)
+CHECK_INCLUDE_FILE("printf.h" HAVE_PRINTF_H)
+IF (HAVE_PRINTF_H)
+	ADD_DEFINITIONS(-DHAVE_PRINTF_H)
+ENDIF (HAVE_PRINTF_H)
+
 ADD_SUBDIRECTORY(triton)
 ADD_SUBDIRECTORY(vlan-mon)
 ADD_SUBDIRECTORY(ctrl)
@@ -123,7 +166,21 @@ ADD_EXECUTABLE(accel-pppd
 	main.c
 )
 
-TARGET_LINK_LIBRARIES(accel-pppd triton rt pthread ${crypto_lib} pcre ucontext)
+# check if we have getcontext/setcontext (not available on MUSL)
+INCLUDE(CheckFunctionExists)
+CHECK_FUNCTION_EXISTS(getcontext HAVE_GETCONTEXT)
+CHECK_FUNCTION_EXISTS(setcontext HAVE_SETCONTEXT)
+
+IF (HAVE_GETCONTEXT AND HAVE_SETCONTEXT)
+	TARGET_LINK_LIBRARIES(accel-pppd triton rt pthread ${crypto_lib} pcre2-8)
+ELSE ()
+	find_library(UCONTEXT_LIBRARY ucontext)
+	IF (UCONTEXT_LIBRARY)
+		TARGET_LINK_LIBRARIES(accel-pppd triton rt pthread ${crypto_lib} pcre2-8 ucontext)
+	ELSE ()
+		TARGET_LINK_LIBRARIES(accel-pppd triton rt pthread ${crypto_lib} pcre2-8)
+	ENDIF ()
+ENDIF ()
